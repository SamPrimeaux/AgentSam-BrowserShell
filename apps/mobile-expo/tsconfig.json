{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "typeRoots": ["./types", "../../node_modules/@types"]
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx", "types/**/*.d.ts"]
}
