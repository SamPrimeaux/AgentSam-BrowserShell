{
  "name": "agentsam-browsershell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:artifacts": "node scripts/build-artifact-index.mjs",
    "build": "node scripts/build-artifact-index.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "build:packages": "node scripts/build-packages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.packages.json",
    "check:boundaries": "node scripts/check-platform-boundaries.mjs",
    "test:packages": "node --test packages/*/test/*.test.mjs",
    "verify": "npm run check:boundaries && npm run typecheck && npm run build:packages && npm run test:packages && npm run build:artifacts",
    "dev:pwa": "vite --config apps/mobile-pwa/vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^1.35.0",
    "@inneranimalmedia/agentsam-loading-scene": "2.6.10",
    "@inneranimalmedia/agentsam-nav": "^2.6.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
