{
  "name": "@inneranimalmedia/agentsam-abs",
  "version": "1.0.0",
  "description": "AgentSam Auto Browser Shell: Autonomous AI-driven browser runtime with clickable history breadcrumbs, ACP protocol integration, and multi-cloud sync (Google Drive, Gmail, ACP).",
  "author": "Inner Animal Media <info@inneranimals.com>",
  "license": "Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./cloud": {
      "types": "./dist/cloudConnector.d.ts",
      "import": "./dist/cloudConnector.js",
      "require": "./dist/cloudConnector.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "keywords": [
    "agentsam",
    "browser-shell",
    "autonomous-agents",
    "acp",
    "breadcrumbs",
    "history-navigation",
    "google-drive",
    "gmail",
    "generative-ui",
    "gemini"
  ]
}
