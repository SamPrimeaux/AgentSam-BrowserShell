{
  "name": "@inneranimalmedia/agentsam-runtime-state",
  "version": "1.0.0",
  "description": "One semantic runtime vocabulary for AgentSam: runtime event -> runtime-event-adapter -> loading scene, compact status, activity timeline, and agentsam.runtime.v1 analytics.",
  "author": "Inner Animal Media <info@inneranimals.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "artifact.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "keywords": ["agentsam", "runtime-state", "observability", "loading-scene", "progress", "telemetry"]
}
