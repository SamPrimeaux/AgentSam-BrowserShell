{
  "name": "@inneranimalmedia/agentsam-proof",
  "version": "1.0.0",
  "description": "The one cross-platform AgentSam proof: a nine-step scenario every lane must pass, the lane comparison metric schema, and the shared capability demonstration screen.",
  "author": "Inner Animal Media <info@inneranimals.com>",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./react": { "types": "./dist/react/index.d.ts", "import": "./dist/react/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md", "artifact.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@inneranimalmedia/agentsam-platform": "^1.0.0",
    "@inneranimalmedia/agentsam-runtime-state": "^1.0.0",
    "@inneranimalmedia/agentsam-telemetry": "^1.0.0"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "engines": { "node": ">=20.0.0" },
  "publishConfig": { "access": "public" },
  "keywords": ["agentsam", "cross-platform", "proof", "benchmark", "capability-demo"]
}
